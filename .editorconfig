root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Must match stylua.toml. StyLua is authoritative for .luau files; this block
# only keeps your editor from fighting it while you type.
[*.{luau,lua}]
indent_style = tab
indent_size = 4
max_line_length = 100

[*.{json,jsonc,yml,yaml,toml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
