# --- Secrets -----------------------------------------------------------------
# Never commit credentials. See the "Security" section of README.md.
.env
.env.*
!.env.example
*.pem
*.key
.ROBLOSECURITY
ClientAppSettings.json

# --- Wally -------------------------------------------------------------------
# Installed packages are reproducible from wally.toml + wally.lock, so they are
# not committed. wally.lock IS committed (see docs/dependencies.md).
/Packages/
/ServerPackages/
/DevPackages/

# --- Generated tooling artifacts ---------------------------------------------
# Regenerated by `rojo sourcemap` and `lune run scripts/fetch-global-types`.
/sourcemap.json
/.tooling/

# --- Build output ------------------------------------------------------------
/build/
*.rbxl
*.rbxlx
*.rbxl.lock
*.rbxlx.lock

# --- Selene ------------------------------------------------------------------
# Generated Roblox standard library definition. Regenerated by CI and by
# `selene generate-roblox-std`.
roblox.yml

# --- Editors / OS ------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
